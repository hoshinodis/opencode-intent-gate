{
  "name": "opencode-intent-gate",
  "version": "0.1.0",
  "description": "TypeSafe Jev-powered intent gate for OpenCode: makes the agent confirm intent before diving into underspecified requests.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoshinodis/opencode-intent-gate.git"
  },
  "homepage": "https://github.com/hoshinodis/opencode-intent-gate#readme",
  "bugs": {
    "url": "https://github.com/hoshinodis/opencode-intent-gate/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "typesafe",
    "jev",
    "llm",
    "agent",
    "guardrails"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.13",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  }
}
